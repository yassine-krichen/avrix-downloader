{
  "name": "avrix-downloader",
  "version": "1.0.0",
  "description": "YouTube Downloader",
  "main": "main.js",
  "scripts": {
    "prestart": "npm --prefix ../avrix_desktop_frontend run build",
    "start": "electron .",
    "prepack": "npm --prefix ../avrix_desktop_frontend run build",
    "predist": "npm --prefix ../avrix_desktop_frontend run build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Avrix",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "get-port": "^7.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.avrix.downloader",
    "productName": "Avrix",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      {
        "from": "../avrix_desktop_frontend/out",
        "to": "avrix_desktop_frontend/out"
      }
    ],
    "extraResources": [
      {
        "from": "../avrix_sidecar_backend/dist/avrix_sidecar",
        "to": "sidecar/avrix_sidecar"
      },
      {
        "from": "build-resources/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "icon": "../assets/images/avrix_icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
